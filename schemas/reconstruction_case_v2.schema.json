{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:modelbench:reconstruction:case:2.0",
  "title": "Single-view reconstruction case v2",
  "description": "Interchange shape. contracts.validate_case additionally checks finite numbers, identity references, bounds, frames, and required capabilities.",
  "type": "object",
  "required": ["case_version", "images", "camera"],
  "properties": {
    "case_version": {"const": "2.0"},
    "units": {"type": "string", "minLength": 1, "default": "arbitrary"},
    "world_frame": {"type": "object", "properties": {"handedness": {"const": "right"}}},
    "images": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {
        "type": "object", "required": ["id", "width", "height"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "width": {"type": "integer", "minimum": 1, "maximum": 100000},
          "height": {"type": "integer", "minimum": 1, "maximum": 100000},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "orientation": {"enum": ["upright", "rotate_90_cw", "rotate_180", "rotate_270_cw"]},
          "crop": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}
        }
      }
    },
    "landmarks": {
      "type": "array", "items": {
        "type": "object", "required": ["id"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "coordinates": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": ["number", "null"]}},
          "initial": {"$ref": "#/$defs/vec3"},
          "bounds": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/vec3"}}
        }
      }
    },
    "observations": {"type": "array", "items": {"$ref": "#/$defs/observation"}},
    "camera": {
      "type": "object", "required": ["model", "intrinsics"],
      "properties": {
        "model": {"enum": ["perspective", "orthographic"]},
        "intrinsics": {
          "type": "object",
          "properties": {
            "units": {"const": "pixels"},
            "focal_length": {"$ref": "#/$defs/parameter"},
            "scale": {"$ref": "#/$defs/parameter"},
            "principal_point": {"$ref": "#/$defs/parameter"},
            "aspect_ratio": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "world_to_camera": {"type": "object", "properties": {"rotation_vector": {"$ref": "#/$defs/parameter"}, "translation": {"$ref": "#/$defs/parameter"}}}
      }
    },
    "constraints": {"type": "array", "items": {"type": "object", "required": ["id", "type"], "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"type": "string"}, "required": {"type": "boolean"}, "role": {"enum": ["evidence", "gauge"]}, "tolerance": {"type": "number", "exclusiveMinimum": 0}, "assumption_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}}}}},
    "assumptions": {"type": "array", "items": {"type": "object", "required": ["id"], "properties": {"id": {"$ref": "#/$defs/id"}}}},
    "measurements": {"type": "array", "items": {"type": "object", "required": ["id"], "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"enum": ["distance", "ratio"]}, "landmarks": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/id"}}, "segments": {"type": "array", "minItems": 2, "maxItems": 2}}}},
    "planes": {"type": "array", "items": {"type": "object", "required": ["id"], "properties": {"id": {"$ref": "#/$defs/id"}, "output_scale": {"type": "number", "exclusiveMinimum": 0}}}},
    "solver": {"type": "object", "properties": {"seed": {"type": "integer", "minimum": 0}, "starts": {"type": "integer", "minimum": 1, "maximum": 64}, "max_nfev": {"type": "integer", "minimum": 1, "maximum": 100000}, "uncertainty_samples": {"type": "integer", "minimum": 0, "maximum": 200}, "uncertainty_branch_radius": {"type": "number", "exclusiveMinimum": 0}}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "vec3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "parameter": {"oneOf": [{"type": "number"}, {"type": "array", "items": {"type": "number"}}, {"type": "object", "properties": {"fixed": {"type": "boolean"}, "value": {}, "initial": {}, "bounds": {"type": "array", "minItems": 2, "maxItems": 2}}}]},
    "observation": {
      "type": "object", "required": ["id", "landmark_id", "image"],
      "anyOf": [{"required": ["sigma"]}, {"required": ["tolerance"]}],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "landmark_id": {"$ref": "#/$defs/id"}, "image_id": {"$ref": "#/$defs/id"},
        "image": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
        "space": {"enum": ["pixels", "normalized"]}, "frame": {"enum": ["source", "oriented", "crop"]},
        "sigma": {"oneOf": [{"type": "number", "exclusiveMinimum": 0}, {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "exclusiveMinimum": 0}}]},
        "tolerance": {"type": "number", "exclusiveMinimum": 0}, "required": {"type": "boolean"}, "weight": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
